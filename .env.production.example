POSTGRES_DB=vee_task_manager
POSTGRES_USER=vee_user
POSTGRES_PASSWORD=changeme

VEE_DATABASE_URL=postgresql+psycopg://vee_user:changeme@postgres:5432/vee_task_manager
VEE_REDIS_URL=redis://redis:6379/0
VEE_CACHE_REDIS_URL=redis://redis:6379/0
VEE_JWT_SECRET_KEY=replace-with-strong-secret
VEE_JWT_REFRESH_SECRET_KEY=replace-with-strong-refresh-secret
# Canonical HTTPS API issuer and branded consent screen. Leave blank to disable issuance.
VEE_OAUTH_ISSUER=
VEE_OAUTH_UI_URL=
VEE_OAUTH_AUDIENCE=zeaplay-api
# Required for email recovery: your approved HTTPS frontend origin, ending /#/reset-password.
# The origin must also be in VEE_CORS_ALLOW_ORIGINS. Do not put an API origin here.
VEE_PASSWORD_RESET_URL=
VEE_PASSWORD_RESET_EXPIRE_MINUTES=15
VEE_TASK_LIST_CACHE_TTL_SECONDS=60
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=15
VEE_DB_POOL_SIZE=5
VEE_DB_MAX_OVERFLOW=5
VEE_MAX_REQUEST_BODY_MB=250
VEE_CORS_ALLOW_ORIGINS=["https://todoplay.urlfactory.website","https://play.zeacrm.com","https://playapi.zeacrm.com"]
# For Nginx Proxy Manager/TLS termination, use the actual proxy peer IPs or private
# Docker CIDRs. Do not use a wildcard or /0. See docs/browser-session-origin-fix/README.md.
NGINX_TRUSTED_PROXY_CIDRS=
FORWARDED_ALLOW_IPS=127.0.0.1
VEE_WEBSOCKET_TRUSTED_ORIGINS=["https://todoplay.urlfactory.website","https://play.zeacrm.com","http://167.86.108.178","http://167.86.108.178:6300"]
VEE_WEBSOCKET_REQUIRE_ORIGIN=true
VEE_WEBSOCKET_REQUIRE_TICKET=true
VEE_WEBSOCKET_TICKET_EXPIRE_MINUTES=2
VEE_WEBSOCKET_MAX_MESSAGE_BYTES=65536
UVICORN_WS_MAX_QUEUE=16
VEE_WEBSOCKET_MAX_CONNECTIONS_PER_USER=6
VEE_MINIO_ENDPOINT=https://replace-with-private-object-storage-host
VEE_MINIO_ACCESS_KEY=replace-with-minio-access-key
VEE_MINIO_SECRET_KEY=replace-with-minio-secret-key
VEE_MINIO_BUCKET_ATTACHMENTS=zea-play-attachments
VEE_MINIO_BUCKET_TICKET_ATTACHMENTS=zeaplay-ticket-attachments
VEE_MINIO_PUBLIC_BASE=https://replace-with-public-object-storage-host
VEE_MEDIA_PRESIGN_RATE_REDIS_URL=redis://redis:6379/1
# Browser push requires a trusted HTTPS frontend origin; a public HTTP IP cannot enable it.
# Replace BOTH placeholders with one matching, persistent VAPID pair and a real contact subject.
# See docs/vps-deployment-167-86-108-178.md, "Enable browser push notifications".
VEE_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VEE_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VEE_VAPID_SUBJECT=mailto:security@example.com

API_URL=/api
PRESENCE_URL=same-origin
WS_URL=/api
TICKET_CHAT_WS_URL=/api
VITE_API_BASE_URL=/api
VITE_API_URL=/api
VITE_PRESENCE_URL=same-origin
VITE_WS_URL=/api
VITE_TICKET_CHAT_WS_URL=/api
VITE_CHAT_URL=same-origin

PRESENCE_PORT=6312
PRESENCE_REDIS_URL=redis://redis:6379
PRESENCE_JWT_SECRET=replace-with-strong-secret
PRESENCE_JWT_ALGORITHM=HS256
PRESENCE_EVENTS_CHANNEL=presence:events
PRESENCE_CORS_ORIGINS=https://todoplay.urlfactory.website,http://167.86.108.178,http://167.86.108.178:6300
PRESENCE_REQUIRE_ORIGIN=true
PRESENCE_ALLOW_LOCALHOST_ORIGINS=false
PRESENCE_MAX_CONNECTIONS_PER_USER=12
PRESENCE_MAX_TOTAL_CONNECTIONS=10000

# Apply fc4d5e6f7a8b before enabling durable categories. Disabled by default.
VEE_REALTIME_OUTBOX_ENABLED=false
VEE_REALTIME_OUTBOX_CATEGORIES=[]
VEE_REALTIME_MAX_EVENT_BYTES=262144
VEE_REALTIME_QUEUE_SIZE=128
VEE_REALTIME_SEND_TIMEOUT=2
VEE_REALTIME_OUTBOX_MAX_PENDING=100000
VEE_REALTIME_OUTBOX_RETENTION_DAYS=7
# Keep 1 until PostgreSQL/Redis multi-process tests pass. Disable bootstrap on all scaled workers.
VEE_API_WORKERS=1
VEE_BOOTSTRAP_SCHEMA=true

# SMTP management: apply ff7a8b9c0d1e, adopt legacy profiles explicitly, then enable.
# Generate Fernet keys outside source control. First key encrypts; remaining keys decrypt during rotation.
# Supply a JSON list through the private server environment; never use a VITE_ variable.
VEE_SMTP_SECRET_KEYS=[]
VEE_SMTP_DELIVERY_ENABLED=false
# Exact host:port exceptions only. IPv6 uses [address]:port. Empty lists block private/plaintext relays.
VEE_SMTP_PRIVATE_HOST_ALLOWLIST=[]
VEE_SMTP_PLAINTEXT_HOST_ALLOWLIST=[]
# Optional private CA PEM path inside the backend container; verification remains mandatory.
# VEE_SMTP_CA_FILE=/run/secrets/smtp-ca.pem
# Active Work: regular users have 3 slots; managers have 5.
# Privileged users retain existing target access permissions with explicit limits.
VEE_ACTIVE_TIMER_ADMIN_LIMIT=5
VEE_ACTIVE_TIMER_OWNER_LIMIT=5
