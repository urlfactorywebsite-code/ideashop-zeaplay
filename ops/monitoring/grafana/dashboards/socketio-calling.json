{
  "uid": "zea-socketio-calling",
  "title": "Zeaplay / Socketio Calling",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "zeaplay",
    "realtime"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connected sockets",
      "datasource": {
        "type": "prometheus",
        "uid": "zeaplay-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(zea_io_clients)",
          "legendFormat": "{{instance}} {{feature}} {{category}} {{status}} {{client}} {{reason}} {{device}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Local presence sessions (not fleet-unique users)",
      "datasource": {
        "type": "prometheus",
        "uid": "zeaplay-prometheus"
      },
